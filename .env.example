# Скопируйте в .env и заполните. Уже заданные переменные окружения важнее этого файла.

# Файл базы данных SQLite (создаётся автоматически).
TIMELIST_DB=data/timelist.db

# Адрес веб-интерфейса и API. Для доступа из локальной сети: 0.0.0.0:8080 — и задайте пароль ниже.
TIMELIST_LISTEN=127.0.0.1:8080

# Пароль веб-интерфейса. Пусто — вход без пароля (допустимо только для 127.0.0.1).
TIMELIST_PASSWORD=

# Токен для интеграций (CRM): заголовок «Authorization: Bearer <токен>».
TIMELIST_API_TOKEN=

# Токен бота от @BotFather. Пусто — бот выключен, работает только интерфейс.
# Боту нужно отключить режим приватности: @BotFather → /setprivacy → Disable.
TELEGRAM_BOT_TOKEN=

# ID рабочих групп через запятую (узнать: команда /id в группе). Пусто — любая группа с ботом.
TELEGRAM_CHAT_ID=

# Реакции бота на сообщения: ✍ — записано, 🤔 — не понял, 🤷 — отправителя нет в справочнике.
TELEGRAM_REACTIONS=true
